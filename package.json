{
  "name": "reliable-chat",
  "version": "1.0.0",
  "description": "群组聊天平台：WebSocket 可靠消息投递、群组准入（公开/申请/私有）、邀请与审批、角色权限矩阵、禁言策略、消息保留期限、群主转让与解散（Node + ws + SQLite）",
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "test": "node --disable-warning=ExperimentalWarning --test"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "ws": "^8.18.0"
  }
}
